[Unit]
Description=TabletForge tablet daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/tabletforged
Restart=on-failure
RestartSec=3
# tabletforged releases its virtual devices on SIGTERM before exiting; give it time.
KillSignal=SIGTERM
TimeoutStopSec=5

[Install]
WantedBy=graphical-session.target
